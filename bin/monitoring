#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

root_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
compose_file=$root_dir/compose.yml
site_config=$root_dir/site.yml
prometheus_config=$root_dir/prometheus.yml
config_tool=$root_dir/lib/monitoring_config.py
runtime_dir=$root_dir/.local
unit_template=$root_dir/systemd/spark-monitoring.service
unit_source=$runtime_dir/spark-monitoring.service
unit_name=spark-monitoring.service
user_config_dir=${XDG_CONFIG_HOME:-$HOME/.config}
unit_target=$user_config_dir/systemd/user/$unit_name
site_config_loaded=false
site_json=
prometheus_container=spark-monitoring-prometheus
grafana_container=spark-monitoring-grafana
node_container=spark-monitoring-node-exporter
spark_a_gateway_url=http://127.0.0.1:30000
prometheus_url=http://127.0.0.1:9090
grafana_url=http://127.0.0.1:3100

log() { printf 'spark-monitoring: %s\n' "$*"; }
fail() { printf 'spark-monitoring: ERROR: %s\n' "$*" >&2; return 1; }

usage() {
  printf 'Usage: %s {validate|initialize|install|status|reload}\n' "$0" >&2
  exit 2
}

require_commands() {
  local command
  for command in curl docker id jq loginctl python3 stat systemctl systemd-analyze tailscale; do
    command -v "$command" >/dev/null || fail "missing command: $command"
  done
  docker compose version >/dev/null
}

load_site_config() {
  local mode
  [[ $site_config_loaded == false ]] || return 0
  [[ -f $site_config && ! -L $site_config ]] || {
    fail "site config is missing; copy site.example.yml to site.yml"
    return 1
  }
  mode=$(stat -c '%a' "$site_config")
  [[ $mode == 600 ]] || {
    fail "site config must be private; run: chmod 600 $site_config"
    return 1
  }
  site_json=$(python3 "$config_tool" validate "$site_config") || {
    fail "site config is invalid: $site_config"
    return 1
  }

  prometheus_volume=$(jq -er '.storage.prometheus_volume' <<<"$site_json")
  grafana_volume=$(jq -er '.storage.grafana_volume' <<<"$site_json")
  grafana_serve_host=$(jq -er '.grafana.serve_host' <<<"$site_json")
  grafana_serve_port=$(jq -er '.grafana.serve_port' <<<"$site_json")
  grafana_public_url="https://${grafana_serve_host}:${grafana_serve_port}"
  site_config_loaded=true
}

render_runtime_files() {
  local action=$1
  python3 "$config_tool" runtime "$action" "$root_dir" "$site_config" "$prometheus_config" \
    "$unit_template" "$unit_source"
}

serve_mapping_valid() {
  local serve_json=$1 web_key
  web_key="${grafana_serve_host}:${grafana_serve_port}"
  jq -e --arg port "$grafana_serve_port" --arg key "$web_key" '
    .TCP[$port] == {"HTTPS": true} and
    .Web[$key].Handlers == {"/": {"Proxy": "http://127.0.0.1:3100"}}
  ' <<<"$serve_json" >/dev/null
}

verify_serve_prerequisite() {
  local serve_json
  serve_json=$(tailscale serve status --json) || {
    fail 'cannot read Tailscale Serve configuration'
    return 1
  }
  serve_mapping_valid "$serve_json" || {
    fail "Grafana Serve prerequisite is missing; run: tailscale serve --bg --https=$grafana_serve_port http://127.0.0.1:3100"
    return 1
  }
}

linger_enabled() {
  [[ $1 == yes ]]
}

verify_linger_prerequisite() {
  local monitoring_user linger
  monitoring_user=$(id -un)
  linger=$(loginctl show-user "$monitoring_user" --property=Linger --value) || {
    fail "cannot read linger state for user: $monitoring_user"
    return 1
  }
  linger_enabled "$linger" || {
    fail "user lingering is disabled; run: sudo loginctl enable-linger $monitoring_user"
    return 1
  }
}

compose() {
  GRAFANA_SERVE_HOST=$grafana_serve_host GRAFANA_SERVE_PORT=$grafana_serve_port \
    PROMETHEUS_VOLUME_NAME=$prometheus_volume GRAFANA_VOLUME_NAME=$grafana_volume \
    docker compose -f "$compose_file" "$@"
}

shutdown_compose() {
  GRAFANA_SERVE_HOST=unused.example.invalid GRAFANA_SERVE_PORT=443 \
    PROMETHEUS_VOLUME_NAME=unused-prometheus-data GRAFANA_VOLUME_NAME=unused-grafana-data \
    docker compose -f "$compose_file" "$@"
}

require_volumes() {
  docker volume inspect "$prometheus_volume" "$grafana_volume" >/dev/null || {
    fail 'persistent volumes are absent; initialize an empty deployment first'
    return 1
  }
}

validate_provisioning() {
  python3 - "$root_dir" <<'PY'
import json
import pathlib
import sys
import yaml

if sys.flags.optimize:
    raise SystemExit("Python assertions must be enabled")
root = pathlib.Path(sys.argv[1])
datasource = yaml.safe_load(
    (root / "grafana/provisioning/datasources/prometheus.yml").read_text(encoding="utf-8")
)
source = datasource["datasources"][0]
assert source["uid"] == "prometheus"
assert source["url"] == "http://127.0.0.1:9090"
assert source["isDefault"] is True

provider = yaml.safe_load(
    (root / "grafana/provisioning/dashboards/dashboards.yml").read_text(encoding="utf-8")
)["providers"][0]
assert provider["options"]["path"] == "/var/lib/grafana/dashboards"

dashboard_files = list((root / "grafana/dashboards").glob("*.json"))
assert [path.name for path in dashboard_files] == ["spark-models.json"]
cluster = json.loads(dashboard_files[0].read_text(encoding="utf-8"))
assert cluster["uid"] == "spark-models"
assert cluster["title"] == "Model Serving"
assert cluster["refresh"] == "2s"
assert len(cluster["panels"]) >= 14

variables = {variable["name"]: variable for variable in cluster["templating"]["list"]}
model_query = variables["model"]["query"]
if isinstance(model_query, dict):
    model_query = model_query["query"]
assert model_query == 'label_values({service="model-worker",node=~"$node"}, model)'
panel_expressions = {
    panel["title"]: "\n".join(target.get("expr", "") for target in panel.get("targets", []))
    for panel in cluster["panels"]
}
required_panels = {
    "Decode throughput (tok/s)": ("sglang:gen_throughput", "llamacpp:predicted_tokens_seconds", "vllm:generation_tokens_total", "tensorfold_health:completion_tokens_total"),
    "Prefill throughput (tok/s)": ("sglang:realtime_tokens_total", "llamacpp:prompt_tokens_seconds", "vllm:prompt_tokens_by_source_total", "tensorfold:prompt_tokens_total", "tensorfold_health:cached_tokens_total"),
    "Running requests": ("tensorfold:requests_running",),
    "Completed request rate": ("sglang:num_requests_total", "vllm:e2e_request_latency_seconds_count", "tensorfold:request_latency_seconds_count"),
    "Queued requests": ("sglang:num_queue_reqs", "llamacpp:requests_deferred", "vllm:num_requests_waiting", "tensorfold:requests_waiting"),
    "vLLM KV cache usage": ("vllm:kv_cache_usage_perc",),
    "MTP acceptance": ("sglang:spec_accept_rate", "llamacpp:spec_decode_num_accepted_tokens_total", "vllm:spec_decode_num_accepted_tokens_total", "tensorfold:mtp_accepted_total", "tensorfold:mtp_drafted_total"),
    "Throughput by active model": ("tensorfold:prompt_tokens_total", "tensorfold_health:cached_tokens_total"),
    "vLLM preemptions": ("vllm:num_preemptions_total",),
    "TensorFold latency and TTFT (finished requests)": ("tensorfold:request_latency_seconds_sum", "tensorfold:time_to_first_token_seconds_bucket"),
    "TensorFold KV pool and stream context occupancy": ("tensorfold_health:pool_free_tokens", "tensorfold:kv_cache_usage_ratio"),
    "TensorFold KV pool capacity": ("tensorfold_health:pool_tokens", "tensorfold_health:context_length"),
    "TensorFold streams by state": ("tensorfold_health:streams",),
    "TensorFold rank/API health (fresh samples)": ("spark_serve_rank_up", "spark_serve_api_up", "spark_serve_probe_timestamp_seconds", "node_textfile_mtime_seconds"),
    "Host memory headroom (MemAvailable / gateway free)": ("spark_serve_host_mem_available_bytes", "spark_serve_probe_timestamp_seconds", "node_textfile_mtime_seconds", "llamaswap_memory_free_bytes"),
}
for title, metrics in required_panels.items():
    assert all(metric in panel_expressions[title] for metric in metrics)
prompt_panel = next(panel for panel in cluster["panels"] if panel["title"] == "Prefill throughput (tok/s)")
prompt_description = prompt_panel.get("description", "").lower()
assert "finished requests" in prompt_description
assert "not a measurement of tensorfold prefill compute throughput" in prompt_description
prompt_expression = panel_expressions["Prefill throughput (tok/s)"]
assert "rate(tensorfold:prompt_tokens_total" in prompt_expression
assert "rate(tensorfold_health:cached_tokens_total" in prompt_expression
assert "on (node, model)" in prompt_expression and "clamp_min" in prompt_expression
mtp_expression = panel_expressions["MTP acceptance"]
assert "sum by (node, model)" in mtp_expression and "clamp_min" in mtp_expression and "rate(" in mtp_expression
assert "rate(tensorfold:mtp_accepted_total" in mtp_expression
assert "rate(tensorfold:mtp_drafted_total" in mtp_expression
for title in ("Decode throughput (tok/s)", "Prefill throughput (tok/s)", "Running requests", "Queued requests"):
    assert "vector(0)" not in panel_expressions[title]
for title in ("TensorFold rank/API health (fresh samples)", "Host memory headroom (MemAvailable / gateway free)"):
    assert "on(model,engine)" in panel_expressions[title]
    assert "on(model,engine,node,rank)" not in panel_expressions[title]
PY
}
validate() {
  local prometheus_image compose_config node_exporter_command
  require_commands
  load_site_config
  render_runtime_files check || {
    fail 'runtime configuration is absent or stale; run install'
    return 1
  }
  require_volumes
  compose_config=$(compose config --format json)
  prometheus_image=$(jq -er '.services.prometheus.image' <<<"$compose_config")
  node_exporter_command=$(jq -cer '.services["node-exporter"].command' <<<"$compose_config")
  jq -e '
    index("--collector.textfile") != null and
    index("--collector.textfile.directory=/host/run/spark-models/telemetry") != null
  ' <<<"$node_exporter_command" >/dev/null || {
    fail 'node-exporter textfile collector does not target the shared telemetry directory'
    return 1
  }
  docker image inspect "$prometheus_image" >/dev/null 2>&1 || {
    fail 'pinned Prometheus image is unavailable locally; install fetches the pinned images'
    return 1
  }
  docker run --rm --pull never \
    --entrypoint /bin/promtool \
    -v "$prometheus_config:/etc/prometheus/prometheus.yml:ro" \
    "$prometheus_image" check config /etc/prometheus/prometheus.yml >/dev/null
  validate_provisioning
  systemd-analyze verify "$unit_source" >/dev/null
  log 'validation passed'
}

initialize() {
  require_commands
  load_site_config
  local volume
  for volume in "$prometheus_volume" "$grafana_volume"; do
    if docker volume inspect "$volume" >/dev/null 2>&1; then
      fail "refusing to initialize existing volume: $volume"
      return 1
    fi
  done
  docker volume create --label spark-monitoring.data=prometheus "$prometheus_volume" >/dev/null
  docker volume create --label spark-monitoring.data=grafana "$grafana_volume" >/dev/null
  log 'empty persistent volumes initialized'
}

wait_ready() {
  local deadline
  deadline=$((SECONDS + 120))
  while ((SECONDS < deadline)); do
    if [[ $(docker inspect -f '{{.State.Running}}' "$prometheus_container" 2>/dev/null || true) == true ]] &&
      [[ $(docker inspect -f '{{.State.Running}}' "$grafana_container" 2>/dev/null || true) == true ]] &&
      [[ $(docker inspect -f '{{.State.Running}}' "$node_container" 2>/dev/null || true) == true ]] &&
      curl -fsS --max-time 3 "$prometheus_url/-/ready" >/dev/null 2>&1 &&
      curl -fsS --max-time 3 "$grafana_url/api/health" >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done
  fail 'monitoring did not become ready'
}

up() {
  require_commands
  load_site_config
  render_runtime_files check || {
    fail 'runtime configuration is absent or stale; run install'
    return 1
  }
  verify_serve_prerequisite
  require_volumes
  if ! compose up -d --remove-orphans; then
    if ! compose down --remove-orphans; then
      fail 'runtime start failed and partial monitoring cleanup failed'
      return 1
    fi
    fail 'runtime start failed'
    return 1
  fi
  if ! wait_ready; then
    if ! compose down --remove-orphans; then
      fail 'monitoring readiness failed and partial monitoring cleanup failed'
    fi
    return 1
  fi
  log 'runtime ready project=spark-monitoring'
}

down() {
  command -v docker >/dev/null || {
    fail 'missing command: docker'
    return 1
  }
  docker compose version >/dev/null || {
    fail 'Docker Compose is unavailable'
    return 1
  }
  shutdown_compose down --remove-orphans
  log 'runtime stopped; persistent volumes retained'
}

install_unit() {
  mkdir -p -- "$(dirname "$unit_target")"
  install -m 0644 "$unit_source" "$unit_target"
  systemctl --user daemon-reload
  systemctl --user enable "$unit_name" >/dev/null
}

target_job_healthy() {
  local targets_response=$1 job=$2
  jq -e --arg job "$job" '
    [.data.activeTargets[] | select(.labels.job == $job)] as $targets |
    (($targets | length) > 0) and all($targets[]; .health == "up")
  ' <<<"$targets_response" >/dev/null
}

target_instance_healthy() {
  local targets_response=$1 job=$2 instance=$3 scrape_url=$4 node=$5 engine=$6
  jq -e --arg job "$job" --arg instance "$instance" --arg scrape_url "$scrape_url" \
    --arg node "$node" --arg engine "$engine" '
    [.data.activeTargets[] |
      select(.labels.job == $job and .labels.instance == $instance and
        .labels.service == "model-worker" and .labels.node == $node and
        .labels.engine == $engine and .scrapeUrl == $scrape_url)] as $targets |
    (($targets | length) == 1) and all($targets[]; .health == "up")
  ' <<<"$targets_response" >/dev/null
}

telemetry_mapping() {
  local node=$1 model=$2 count
  count=$(jq -r --arg node "$node" --arg model "$model" '
    [.model_telemetry[] |
      select(.node == $node) as $entry |
      $entry.identities[] |
      select(.running == $model) |
      [.model, $entry.scrape.job, $entry.scrape.target, $entry.activity_metric,
       ($entry.proxy_port | tostring), $entry.scrape.scheme, $entry.scrape.metrics_path,
       $entry.engine] | @tsv] |
    if length == 1 then .[0] else empty end
  ' <<<"$site_json")
  [[ -n $count ]] || {
    fail "no unique scrape policy for active worker: node=$node model=$model"
    return 1
  }
  printf '%s\n' "$count"
}

active_proxy_port() {
  local proxy=$1 authority
  authority=${proxy#*://}
  authority=${authority%%/*}
  if [[ $authority =~ ^\[[^]]+\]:([0-9]+)$ ]] || [[ $authority =~ ^[^:]+:([0-9]+)$ ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
    return 0
  fi
  return 1
}

fetch_running() {
  local node=$1 url=$2 response
  response=$(curl -fsS --connect-timeout 3 --max-time 10 "$url/running") || {
    fail "cannot query active workers: node=$node"
    return 1
  }
  jq -e '
    type == "object" and
    (.running | type == "array") and
    all(.running[];
      (.model | type == "string") and (.model | length > 0) and
      (.proxy | type == "string") and (.proxy | length > 0))
  ' <<<"$response" >/dev/null || {
    fail "invalid active-worker response: node=$node"
    return 1
  }
  printf '%s\n' "$response"
}

fetch_active_snapshot() {
  local node url response snapshot='[]'
  while IFS=$'\t' read -r node url; do
    response=$(fetch_running "$node" "$url")
    snapshot=$(jq -cn --argjson snapshot "$snapshot" --argjson response "$response" \
      --arg node "$node" '$snapshot + [$response.running[] | {node: $node, model, proxy}]')
  done < <(jq -r '.serving_nodes[] | [.name, .running_url] | @tsv' <<<"$site_json")
  jq -cS 'sort_by(.node, .model, .proxy)' <<<"$snapshot"
}

fetch_targets() {
  local response
  response=$(curl -fsS --connect-timeout 3 --max-time 10 "$prometheus_url/api/v1/targets") || {
    fail 'cannot query Prometheus targets'
    return 1
  }
  jq -e '.status == "success" and (.data.activeTargets | type == "array")' \
    <<<"$response" >/dev/null || {
    fail 'invalid Prometheus targets response'
    return 1
  }
  printf '%s\n' "$response"
}

validate_active_snapshot() {
  local snapshot=$1 rows node model proxy policy expected_proxy_port actual_proxy_port
  jq -e '
    type == "array" and
    (length == ([.[] | [.node, .model, .proxy] | join("\u0000")] | unique | length)) and
    (length == ([.[] | [.node, .model] | join("\u0000")] | unique | length))
  ' <<<"$snapshot" >/dev/null || {
    fail 'active-worker snapshot contains duplicate or ambiguous entries'
    return 1
  }
  rows=$(jq -r '.[] | [.node, .model, .proxy] | @tsv' <<<"$snapshot")
  while IFS=$'\t' read -r node model proxy; do
    [[ -n $node && -n $model && -n $proxy ]] || continue
    [[ $model =~ ^[A-Za-z0-9._/-]+$ ]] || {
      fail "unsafe active model identifier: node=$node model=$model"
      return 1
    }
    [[ $proxy =~ ^https?://[^[:space:]]+$ ]] || {
      fail "unsafe active proxy: node=$node model=$model"
      return 1
    }
    policy=$(telemetry_mapping "$node" "$model") || return 1
    IFS=$'\t' read -r _ _ _ _ expected_proxy_port _ _ _ <<<"$policy"
    actual_proxy_port=$(active_proxy_port "$proxy") || {
      fail "active worker proxy has no explicit port: node=$node model=$model"
      return 1
    }
    [[ $actual_proxy_port == "$expected_proxy_port" ]] || {
      fail "active worker proxy port does not match scrape policy: node=$node model=$model"
      return 1
    }
  done <<<"$rows"
}

active_worker_telemetry_healthy() {
  local snapshot=$1 targets_response=$2 rows node model proxy policy
  local prom_model job instance metric expected_proxy_port scheme path engine scrape_url query query_response
  telemetry_loaded=()
  telemetry_error=
  rows=$(jq -r '.[] | [.node, .model, .proxy] | @tsv' <<<"$snapshot")
  while IFS=$'\t' read -r node model proxy; do
    [[ -n $node && -n $model && -n $proxy ]] || continue
    policy=$(telemetry_mapping "$node" "$model") || return 1
    IFS=$'\t' read -r prom_model job instance metric expected_proxy_port scheme path engine <<<"$policy"
    scrape_url="${scheme}://${instance}${path}"
    if ! target_instance_healthy "$targets_response" "$job" "$instance" "$scrape_url" "$node" "$engine"; then
      telemetry_error="active worker has no healthy scrape: node=$node model=$prom_model job=$job instance=$instance"
      return 1
    fi
    query="count((time() - timestamp(${metric}{job=\"${job}\",instance=\"${instance}\",model=\"${prom_model}\"})) < 15)"
    if ! query_response=$(curl -fsS --connect-timeout 3 --max-time 10 "$prometheus_url/api/v1/query" \
      --get --data-urlencode "query=$query"); then
      telemetry_error="active worker telemetry query failed: node=$node model=$prom_model"
      return 1
    fi
    if ! jq -e '
      .status == "success" and
      ((.data.result[0].value[1] // "0") | tonumber > 0)
    ' <<<"$query_response" >/dev/null; then
      telemetry_error="active worker has no correctly labeled telemetry: node=$node model=$prom_model job=$job"
      return 1
    fi
    telemetry_loaded+=("$node/$prom_model:$job@$instance")
  done <<<"$rows"
}

qualify_active_workers() {
  local initial_snapshot current_snapshot healthy converged=false attempt job
  initial_snapshot=$(fetch_active_snapshot)
  validate_active_snapshot "$initial_snapshot"
  for attempt in 1 2 3 4 5 6; do
    targets_response=$(fetch_targets)
    while IFS= read -r job; do
      target_job_healthy "$targets_response" "$job" || {
        fail "required scrape job is not healthy: $job"
        return 1
      }
    done < <(jq -r '.serving_nodes[].gateway_scrape.job, "node"' <<<"$site_json")

    healthy=false
    if active_worker_telemetry_healthy "$initial_snapshot" "$targets_response"; then
      healthy=true
    fi
    current_snapshot=$(fetch_active_snapshot)
    if [[ $current_snapshot != "$initial_snapshot" ]]; then
      fail 'active worker set changed during telemetry qualification'
      return 1
    fi
    if [[ $healthy == true ]]; then
      converged=true
      break
    fi
    if ((attempt < 6)); then
      sleep 2
    fi
  done
  [[ $converged == true ]] || fail "telemetry did not converge: $telemetry_error"
}

validate_live_dashboard() {
  local dashboard_response=$1
  jq -e '
    [.dashboard.panels[] | {title, description, expression: ([.targets[]?.expr] | join("\n"))}] as $panels |
    def expression($title): $panels[] | select(.title == $title) | .expression;
    def description($title): $panels[] | select(.title == $title) | .description;
    .meta.provisioned == true and
    .dashboard.uid == "spark-models" and
    .dashboard.title == "Model Serving" and
    any(.dashboard.templating.list[];
      .name == "model" and
      ((.query.query // .query) == "label_values({service=\"model-worker\",node=~\"$node\"}, model)")) and
    (expression("Decode throughput (tok/s)") | contains("vllm:generation_tokens_total")) and
    (expression("Decode throughput (tok/s)") | contains("tensorfold_health:completion_tokens_total")) and
    (expression("Decode throughput (tok/s)") | contains("vector(0)") | not) and
    (expression("Prefill throughput (tok/s)") | contains("vllm:prompt_tokens_by_source_total")) and
    (expression("Prefill throughput (tok/s)") | contains("tensorfold:prompt_tokens_total")) and
    (expression("Prefill throughput (tok/s)") | contains("tensorfold_health:cached_tokens_total")) and
    (expression("Prefill throughput (tok/s)") | contains("rate(tensorfold:prompt_tokens_total")) and
    (expression("Prefill throughput (tok/s)") | contains("rate(tensorfold_health:cached_tokens_total")) and
    (expression("Prefill throughput (tok/s)") | contains("on (node, model)")) and
    (expression("Prefill throughput (tok/s)") | contains("clamp_min")) and
    (description("Prefill throughput (tok/s)") | ascii_downcase | contains("finished requests")) and
    (description("Prefill throughput (tok/s)") | ascii_downcase | contains("not a measurement of tensorfold prefill compute throughput")) and
    (expression("Prefill throughput (tok/s)") | contains("vector(0)") | not) and
    (expression("Running requests") | contains("tensorfold:requests_running")) and
    (expression("Running requests") | contains("vector(0)") | not) and
    (expression("Completed request rate") | contains("vllm:e2e_request_latency_seconds_count")) and
    (expression("Completed request rate") | contains("tensorfold:request_latency_seconds_count")) and
    (expression("Queued requests") | contains("vllm:num_requests_waiting")) and
    (expression("Queued requests") | contains("tensorfold:requests_waiting")) and
    (expression("Queued requests") | contains("vector(0)") | not) and
    (expression("vLLM KV cache usage") | contains("vllm:kv_cache_usage_perc")) and
    (expression("vLLM KV cache usage") | contains("vector(0)") | not) and
    (expression("MTP acceptance") | contains("vllm:spec_decode_num_accepted_tokens_total")) and
    (expression("MTP acceptance") | contains("tensorfold:mtp_accepted_total")) and
    (expression("MTP acceptance") | contains("tensorfold:mtp_drafted_total")) and
    (expression("MTP acceptance") | contains("rate(tensorfold:mtp_accepted_total")) and
    (expression("MTP acceptance") | contains("rate(tensorfold:mtp_drafted_total")) and
    (expression("MTP acceptance") | contains("clamp_min")) and
    (expression("MTP acceptance") | contains("sum by (node, model)")) and
    (expression("Throughput by active model") | contains("tensorfold:prompt_tokens_total")) and
    (expression("Throughput by active model") | contains("tensorfold_health:cached_tokens_total")) and
    (expression("vLLM preemptions") | contains("vllm:num_preemptions_total")) and
    (expression("TensorFold latency and TTFT (finished requests)") | contains("tensorfold:request_latency_seconds_sum")) and
    (expression("TensorFold latency and TTFT (finished requests)") | contains("tensorfold:time_to_first_token_seconds_bucket")) and
    (expression("TensorFold KV pool and stream context occupancy") | contains("tensorfold_health:pool_free_tokens")) and
    (expression("TensorFold KV pool and stream context occupancy") | contains("tensorfold:kv_cache_usage_ratio")) and
    (expression("TensorFold KV pool capacity") | contains("tensorfold_health:pool_tokens")) and
    (expression("TensorFold KV pool capacity") | contains("tensorfold_health:context_length")) and
    (expression("TensorFold streams by state") | contains("tensorfold_health:streams")) and
    (expression("TensorFold rank/API health (fresh samples)") | contains("spark_serve_rank_up")) and
    (expression("TensorFold rank/API health (fresh samples)") | contains("spark_serve_api_up")) and
    (expression("TensorFold rank/API health (fresh samples)") | contains("spark_serve_probe_timestamp_seconds")) and
    (expression("TensorFold rank/API health (fresh samples)") | contains("on(model,engine)")) and
    (expression("TensorFold rank/API health (fresh samples)") | contains("node_textfile_mtime_seconds")) and
    (expression("TensorFold rank/API health (fresh samples)") | contains("on()")) and
    (expression("TensorFold rank/API health (fresh samples)") | contains("< 45")) and
    (expression("Host memory headroom (MemAvailable / gateway free)") | contains("spark_serve_host_mem_available_bytes")) and
    (expression("Host memory headroom (MemAvailable / gateway free)") | contains("spark_serve_probe_timestamp_seconds")) and
    (expression("Host memory headroom (MemAvailable / gateway free)") | contains("on(model,engine)")) and
    (expression("Host memory headroom (MemAvailable / gateway free)") | contains("node_textfile_mtime_seconds")) and
    (expression("Host memory headroom (MemAvailable / gateway free)") | contains("on()")) and
    (expression("Host memory headroom (MemAvailable / gateway free)") | contains("< 45")) and
    (expression("Host memory headroom (MemAvailable / gateway free)") | contains("llamaswap_memory_free_bytes"))
  ' <<<"$dashboard_response" >/dev/null
}

status() {
  local containers mounts_ok targets_response dashboard_response target_summary loaded_summary telemetry_error
  local -a telemetry_loaded=()

  require_commands
  load_site_config
  render_runtime_files check || {
    fail 'runtime configuration is absent or stale; run install'
    return 1
  }
  verify_serve_prerequisite
  require_volumes
  systemctl --user is-enabled "$unit_name" >/dev/null
  systemctl --user is-active "$unit_name" >/dev/null
  for container in "$prometheus_container" "$grafana_container" "$node_container"; do
    [[ $(docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null || true) == true ]] ||
      fail "container is not running: $container"
  done

  containers=$(docker inspect "$prometheus_container" "$grafana_container" "$node_container")
  jq -e 'all(.[]; .State.Running == true and .State.OOMKilled == false and .RestartCount == 0)' \
    <<<"$containers" >/dev/null || fail 'monitoring container has an OOM or automatic restart history'
  mounts_ok=$(jq -r \
    --arg root "$root_dir" --arg compose "$compose_file" \
    --arg prom "$prometheus_volume" --arg graf "$grafana_volume" '
      [.[] | .Mounts[]] as $mounts |
      all(.[];
        .Config.Labels["com.docker.compose.project"] == "spark-monitoring" and
        .Config.Labels["com.docker.compose.project.config_files"] == $compose) and
      any($mounts[]; .Type == "volume" and .Name == $prom and .Destination == "/prometheus") and
      any($mounts[]; .Type == "volume" and .Name == $graf and .Destination == "/var/lib/grafana") and
      any($mounts[]; .Type == "bind" and .Source == "/" and .Destination == "/host" and .RW == false) and
      all($mounts[] | select(.Type == "bind" and .Destination != "/host"); .Source | startswith($root))
    ' <<<"$containers")
  [[ $mounts_ok == true ]] || fail 'live mounts or Compose ownership do not match this repository'
  jq -e '
    [.[] | select(.Name == "/spark-monitoring-node-exporter")] as $node |
    ($node | length) == 1 and
    ($node[0].Config.Cmd | index("--collector.textfile") != null) and
    ($node[0].Config.Cmd | index("--collector.textfile.directory=/host/run/spark-models/telemetry") != null)
  ' <<<"$containers" >/dev/null || fail 'live node-exporter textfile collector is not configured for telemetry'

  curl -fsS --max-time 10 "$prometheus_url/-/ready" >/dev/null
  curl -fsS --max-time 10 "$grafana_url/api/health" >/dev/null
  curl -fsS --max-time 15 "$grafana_public_url/api/health" >/dev/null

  qualify_active_workers

  dashboard_response=$(curl -fsS --max-time 10 "$grafana_url/api/dashboards/uid/spark-models")
  validate_live_dashboard "$dashboard_response" || fail 'provisioned cluster dashboard does not match monitoring policy'

  target_summary=$(jq -c '
    .data.activeTargets | group_by(.health) |
    map({health: .[0].health, count: length})
  ' <<<"$targets_response")
  if ((${#telemetry_loaded[@]})); then
    loaded_summary=$(IFS=,; printf '%s' "${telemetry_loaded[*]}")
  else
    loaded_summary=none
  fi
  log "status ready project=spark-monitoring targets=$target_summary loaded=$loaded_summary dashboard=spark-models serve=verified"
  jq -r '.[] |
    [.Name[1:], .Id[0:12], .State.Status, (.RestartCount | tostring),
     ([.Mounts[] | select(.Type == "volume") | .Name] | join(","))] | @tsv
  ' <<<"$containers"
}

install_stack() {
  require_commands
  load_site_config
  verify_serve_prerequisite
  verify_linger_prerequisite
  require_volumes
  render_runtime_files write
  compose config --quiet
  compose pull
  validate
  install_unit
  if systemctl --user is-active --quiet "$unit_name"; then
    systemctl --user restart "$unit_name"
  else
    systemctl --user start "$unit_name"
  fi
  status
}

reload_stack() {
  require_commands
  load_site_config
  verify_serve_prerequisite
  render_runtime_files write
  validate
  compose up -d --no-deps --force-recreate prometheus grafana node-exporter
  wait_ready
  status
}

if [[ ${MONITORING_SOURCE_ONLY:-false} == true ]]; then
  return 0
fi

case ${1:-} in
  validate) (($# == 1)) || usage; validate ;;
  initialize) (($# == 1)) || usage; initialize ;;
  install) (($# == 1)) || usage; install_stack ;;
  status) (($# == 1)) || usage; status ;;
  reload) (($# == 1)) || usage; reload_stack ;;
  up) (($# == 1)) || usage; up ;;
  down) (($# == 1)) || usage; down ;;
  *) usage ;;
esac
