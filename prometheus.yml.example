global:
  scrape_interval: 5s
  scrape_timeout: 4s
  evaluation_interval: 5s
  external_labels:
    cluster: dgx-spark

scrape_configs:
  - job_name: llama-swap
    metrics_path: /metrics
    static_configs:
      - targets:
          - 127.0.0.1:30000
        labels:
          service: model-gateway
          node: spark-a

  - job_name: llama-swap-spark-b
    scheme: https
    metrics_path: /metrics
    static_configs:
      - targets:
          - {{SPARK_B_HOST}}:{{SPARK_B_GATEWAY_PORT}}
        labels:
          service: model-gateway
          node: spark-b

  - job_name: sglang
    metrics_path: /metrics
    static_configs:
      - targets:
          - 127.0.0.1:32100
        labels:
          service: model-worker
          model: qwen3.8-27b
          engine: sglang
          node: spark-a

  - job_name: sglang-orca-nvfp4
    metrics_path: /metrics
    static_configs:
      - targets:
          - 127.0.0.1:32106
        labels:
          service: model-worker
          model: qwen3.8-27b-uncensored-nvfp4
          engine: sglang
          node: spark-a

  - job_name: vllm-qwen38-flash-next-2x
    metrics_path: /metrics
    static_configs:
      - targets:
          - 127.0.0.1:32104
        labels:
          service: model-worker
          model: qwen3.8-flash-next
          engine: vllm
          node: spark-a

  - job_name: llamacpp
    metrics_path: /metrics
    static_configs:
      - targets:
          - 127.0.0.1:32101
        labels:
          service: model-worker
          model: qwen3.8-27b-uncensored
          engine: llamacpp
          node: spark-a

  - job_name: vllm-deepseek-v4-flash-2x
    metrics_path: /metrics
    static_configs:
      - targets:
          - 127.0.0.1:32102
        labels:
          service: model-worker
          engine: vllm
          node: spark-a
    metric_relabel_configs:
      - source_labels: [model_name]
        regex: (deepseek-v4-flash-(0731|vision-exp)(-abliterated)?)
        target_label: model
        replacement: $1

  - job_name: vllm-glm53-exl3-2x
    metrics_path: /metrics
    static_configs:
      - targets:
          - 127.0.0.1:32105
        labels:
          service: model-worker
          model: glm-5.3-flash-exl3
          engine: vllm
          node: spark-a
    metric_relabel_configs:
      - source_labels: [model_name]
        regex: (glm-5\.3-flash-exl3(-abliterated)?)
        target_label: model
        replacement: $1

  - job_name: llamacpp-spark-b
    scheme: https
    metrics_path: /worker-orca/metrics
    static_configs:
      - targets:
          - {{SPARK_B_HOST}}:{{SPARK_B_GATEWAY_PORT}}
        labels:
          service: model-worker
          model: spark-b/qwen3.8-27b-uncensored
          engine: llamacpp
          node: spark-b

  - job_name: vllm-spark-b
    scheme: https
    metrics_path: /worker-vllm/metrics
    static_configs:
      - targets:
          - {{SPARK_B_HOST}}:{{SPARK_B_GATEWAY_PORT}}
        labels:
          service: model-worker
          model: spark-b/deepseek-v4-flash-0731
          engine: vllm
          node: spark-b

  - job_name: deepseek-live-throughput-spark-b
    scheme: https
    metrics_path: /deepseek-throughput/metrics
    static_configs:
      - targets:
          - {{SPARK_B_HOST}}:{{SPARK_B_GATEWAY_PORT}}
        labels:
          service: model-throughput
          model: spark-b/deepseek-v4-flash-0731
          engine: vllm
          node: spark-b

  - job_name: llama-swap-rd-legion
    metrics_path: /metrics
    static_configs:
      - targets:
          - {{RD_LEGION_HOST}}:{{RD_GATEWAY_PORT}}
        labels:
          service: model-gateway
          node: rd-legion

  - job_name: llamacpp-rd-legion
    metrics_path: /metrics
    static_configs:
      - targets:
          - {{RD_LEGION_HOST}}:{{RD_KAT_CODER_PORT}}
        labels:
          service: model-worker
          model: rd-legion/kat-coder-v2.5-dev
          engine: llamacpp
          node: rd-legion
      - targets:
          - {{RD_LEGION_HOST}}:{{RD_QWEN_128K_PORT}}
        labels:
          service: model-worker
          model: rd-legion/qwen38-27b-128k
          engine: llamacpp
          node: rd-legion
      - targets:
          - {{RD_LEGION_HOST}}:{{RD_QWEN_OBLITERATED_PORT}}
        labels:
          service: model-worker
          model: rd-legion/qwen38-27b-obliterated
          engine: llamacpp
          node: rd-legion
      - targets:
          - {{RD_LEGION_HOST}}:{{RD_QWEN_ORCA_PORT}}
        labels:
          service: model-worker
          model: rd-legion/qwen38-27b-orca-uncensored
          engine: llamacpp
          node: rd-legion

  - job_name: node
    static_configs:
      - targets:
          - 127.0.0.1:9100
        labels:
          service: host
          node: spark-a
